@model BedFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="WardId" class="form-label"></label>
        <select asp-for="WardId" asp-items="Model.Wards" class="form-select">
            <option value="">-- select ward --</option>
        </select>
        <span asp-validation-for="WardId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BedNumber" class="form-label"></label>
        <input asp-for="BedNumber" class="form-control" />
        <span asp-validation-for="BedNumber" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
</div>
