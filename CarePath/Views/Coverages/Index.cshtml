@model CoverageIndexViewModel
@{
    ViewData["Title"] = "Insurance coverage";
    var canEdit = User.IsInRole(Roles.Physician) || User.IsInRole(Roles.Nurse) || User.IsInRole(Roles.BillingClerk);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Insurance coverage</h1>
    @if (canEdit)
    {
        <a class="btn btn-primary" asp-action="Create">Attach coverage</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-md-4">
        <label asp-for="Search" class="form-label"></label>
        <input asp-for="Search" class="form-control" />
        <span asp-validation-for="Search" class="text-danger"></span>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input asp-for="ActiveOnly" class="form-check-input" />
        <label asp-for="ActiveOnly" class="form-check-label"></label>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filter</button></div>
</form>

<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>Patient</th><th>Payer</th><th>Member id</th><th>Effective</th><th>Coverage %</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var c in Model.Results.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@c.Id">@c.Patient.FullName</a> <span class="small text-muted">@c.Patient.MedicalRecordNumber</span></td>
                <td>@c.Payer.Name</td>
                <td>@c.MemberId</td>
                <td>@c.EffectiveFrom.ToString("yyyy-MM-dd") to @(c.EffectiveTo?.ToString("yyyy-MM-dd") ?? "open")</td>
                <td>@c.CoveragePercent.ToString("0.##")</td>
                <td><span class="badge @StatusBadges.Active(c.IsActive)">@(c.IsActive ? "Active" : "Terminated")</span></td>
            </tr>
        }
        @if (Model.Results.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No coverage records match.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pager" model="Model.Results" />
