@model InvoiceIndexViewModel
@{
    ViewData["Title"] = "Invoices";
}
<h1 class="h3 mb-3">Invoices</h1>
<p class="text-muted">Draft invoices are generated automatically when a patient is discharged.</p>
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-md-4">
        <label asp-for="Search" class="form-label"></label>
        <input asp-for="Search" class="form-control" />
        <span asp-validation-for="Search" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InvoiceStatus>()" class="form-select"><option value="">Any</option></select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filter</button></div>
</form>
<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>Invoice</th><th>Patient</th><th>Admission</th><th>Created</th><th>Due</th><th class="text-end">Total</th><th class="text-end">Patient owes</th><th class="text-end">Balance</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var i in Model.Results.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@i.Id">@i.InvoiceNumber</a></td>
                <td>@i.Patient.FullName <span class="small text-muted">@i.Patient.MedicalRecordNumber</span></td>
                <td>@i.Admission.AdmissionNumber</td>
                <td>@i.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>@(i.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td class="text-end">@i.SubTotal.ToString("N2")</td>
                <td class="text-end">@i.PatientResponsibility.ToString("N2")</td>
                <td class="text-end">@i.BalanceDue.ToString("N2")</td>
                <td><span class="badge @StatusBadges.For(i.Status)">@i.Status</span></td>
            </tr>
        }
        @if (Model.Results.Items.Count == 0)
        {
            <tr><td colspan="9" class="text-muted">No invoices match.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pager" model="Model.Results" />
