@model PaymentViewModel
@{
    ViewData["Title"] = "Record payment";
}
<h1 class="h3 mb-1">Record payment for @Model.InvoiceNumber</h1>
<p class="text-muted">@Model.PatientName &middot; balance due @Model.BalanceDue.ToString("N2")</p>
<form asp-action="Payment" asp-route-id="@Model.InvoiceId" method="post" class="card card-body shadow-sm" style="max-width: 36rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="InvoiceId" />
    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" step="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Method" class="form-label"></label>
        <select asp-for="Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select">
            <option value="">-- select --</option>
        </select>
        <span asp-validation-for="Method" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reference" class="form-label"></label>
        <input asp-for="Reference" class="form-control" />
        <span asp-validation-for="Reference" class="text-danger"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-success">Record payment</button>
        <a asp-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-link">Cancel</a>
    </div>
</form>
