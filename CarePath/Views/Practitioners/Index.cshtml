@model PractitionerIndexViewModel
@{
    ViewData["Title"] = "Practitioners";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Practitioners</h1>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="btn btn-primary" asp-action="Create">Add practitioner</a>
    }
</div>
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-md-4">
        <label asp-for="Search" class="form-label"></label>
        <input asp-for="Search" class="form-control" />
        <span asp-validation-for="Search" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<PractitionerType>()" class="form-select">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input asp-for="ActiveOnly" class="form-check-input" />
        <label asp-for="ActiveOnly" class="form-check-label"></label>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filter</button></div>
</form>
<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>Name</th><th>Type</th><th>License</th><th>Specialty</th><th>Contact</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var p in Model.Practitioners)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@p.Id">@p.DisplayName</a></td>
                <td>@p.Type</td>
                <td>@p.LicenseNumber</td>
                <td>@(p.Specialty?.Name ?? "-")</td>
                <td>@p.Email @p.Phone</td>
                <td><span class="badge @StatusBadges.Active(p.IsActive)">@(p.IsActive ? "Active" : "Inactive")</span></td>
            </tr>
        }
        @if (Model.Practitioners.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No practitioners match.</td></tr>
        }
    </tbody>
</table>
