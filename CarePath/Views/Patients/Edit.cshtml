@model PatientFormViewModel
@{
    ViewData["Title"] = "Edit demographics";
}
<h1 class="h3 mb-3">Edit demographics</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    <partial name="_PatientForm" model="Model" />
    <div>
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>
