@model PatientIndexViewModel
@{
    ViewData["Title"] = "Patients";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Patients</h1>
    <a class="btn btn-primary" asp-action="Create">Register patient</a>
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-md-4">
        <label asp-for="Search" class="form-label"></label>
        <input asp-for="Search" class="form-control" placeholder="e.g. MRN-1001 or Sharma" />
        <span asp-validation-for="Search" class="text-danger"></span>
    </div>
    <div class="col-auto form-check ms-2 mb-2">
        <input asp-for="IncludeInactive" class="form-check-input" />
        <label asp-for="IncludeInactive" class="form-check-label"></label>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Search</button></div>
</form>

<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>MRN</th><th>Name</th><th>Date of birth</th><th>Gender</th><th>Phone</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var p in Model.Results.Items)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@p.Id">@p.MedicalRecordNumber</a></td>
                <td>@p.FullName</td>
                <td>@p.DateOfBirth.ToString("yyyy-MM-dd")</td>
                <td>@p.Gender</td>
                <td>@p.Phone</td>
                <td><span class="badge @StatusBadges.Active(p.IsActive)">@(p.IsActive ? "Active" : "Deactivated")</span></td>
            </tr>
        }
        @if (Model.Results.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No patients match the search.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pager" model="Model.Results" />
