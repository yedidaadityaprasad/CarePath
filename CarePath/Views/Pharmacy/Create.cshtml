@model WardStockFormViewModel
@{
    ViewData["Title"] = "Add stock line";
}
<h1 class="h3 mb-3">Add ward stock line</h1>
<form asp-action="Create" method="post" class="card card-body shadow-sm" style="max-width: 48rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="WardId" class="form-label"></label>
            <select asp-for="WardId" asp-items="Model.Wards" class="form-select"><option value="">-- select --</option></select>
            <span asp-validation-for="WardId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DrugId" class="form-label"></label>
            <select asp-for="DrugId" asp-items="Model.Drugs" class="form-select"><option value="">-- select --</option></select>
            <span asp-validation-for="DrugId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="InitialQuantity" class="form-label"></label>
            <input asp-for="InitialQuantity" class="form-control" />
            <span asp-validation-for="InitialQuantity" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ReorderLevel" class="form-label"></label>
            <input asp-for="ReorderLevel" class="form-control" />
            <span asp-validation-for="ReorderLevel" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
