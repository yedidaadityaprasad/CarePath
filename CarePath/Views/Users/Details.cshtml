@model UserDetailsViewModel
@{
    var u = Model.User;
    ViewData["Title"] = u.Email;
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">@u.FullName</h1>
        <div class="text-muted">@u.Email &middot; @string.Join(", ", u.Roles)</div>
    </div>
    <span class="badge fs-6 @StatusBadges.Active(u.IsActive)">@(u.IsActive ? "Active" : "Disabled")</span>
</div>
<a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm mb-3">Edit</a>
<div class="card shadow-sm">
    <div class="card-header">Recent activity</div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead><tr><th>When</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
            <tbody>
                @foreach (var e in Model.RecentActivity)
                {
                    <tr>
                        <td><a asp-controller="Audit" asp-action="Details" asp-route-id="@e.Id">@e.Timestamp.ToString("yyyy-MM-dd HH:mm")</a></td>
                        <td>@e.Action</td>
                        <td>@e.EntityName #@e.EntityId</td>
                        <td>@e.Details</td>
                    </tr>
                }
                @if (Model.RecentActivity.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">No recorded activity.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<a asp-action="Index" class="btn btn-link mt-2 px-0">Back to users</a>
