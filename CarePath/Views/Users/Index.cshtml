@model UserIndexViewModel
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">User accounts</h1>
    <a class="btn btn-primary" asp-action="Create">Create user</a>
</div>
<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>Email</th><th>Name</th><th>Roles</th><th>Created</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@u.Id">@u.Email</a></td>
                <td>@u.FullName</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>@u.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td><span class="badge @StatusBadges.Active(u.IsActive)">@(u.IsActive ? "Active" : "Disabled")</span></td>
            </tr>
        }
    </tbody>
</table>
