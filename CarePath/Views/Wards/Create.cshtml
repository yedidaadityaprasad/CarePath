@model WardFormViewModel
@{
    ViewData["Title"] = "Add ward";
}
<h1 class="h3 mb-3">Add ward</h1>
<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <partial name="_WardForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
