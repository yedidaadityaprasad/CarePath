@model MedicationOrderFormViewModel
@{
    ViewData["Title"] = "New medication order";
}
<h1 class="h3 mb-3">New medication order</h1>
<p class="text-muted">Orders are checked against the patient's recorded allergies.</p>
<form asp-action="CreateMedication" method="post" class="card card-body shadow-sm" style="max-width: 52rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="AdmissionId" class="form-label"></label>
            <select asp-for="AdmissionId" asp-items="Model.Admissions" class="form-select">
                <option value="">-- select open admission --</option>
            </select>
            <span asp-validation-for="AdmissionId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OrderingPractitionerId" class="form-label"></label>
            <select asp-for="OrderingPractitionerId" asp-items="Model.Practitioners" class="form-select">
                <option value="">-- select --</option>
            </select>
            <span asp-validation-for="OrderingPractitionerId" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="DrugId" class="form-label"></label>
            <select asp-for="DrugId" asp-items="Model.Drugs" class="form-select">
                <option value="">-- select drug --</option>
            </select>
            <span asp-validation-for="DrugId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<OrderPriority>()" class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Dose" class="form-label"></label>
            <input asp-for="Dose" class="form-control" placeholder="500 mg" />
            <span asp-validation-for="Dose" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Route" class="form-label"></label>
            <input asp-for="Route" class="form-control" placeholder="Oral" />
            <span asp-validation-for="Route" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Frequency" class="form-label"></label>
            <input asp-for="Frequency" class="form-control" placeholder="TDS" />
            <span asp-validation-for="Frequency" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Place order</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
