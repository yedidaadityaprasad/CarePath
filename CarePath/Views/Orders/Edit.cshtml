@model OrderEditViewModel
@{
    ViewData["Title"] = "Edit order";
    var medication = Model.Type == OrderType.Medication;
}
<h1 class="h3 mb-1">Edit order @Model.OrderNumber</h1>
<p class="text-muted">@Model.Type: @Model.Description. Only orders that have not started can be changed.</p>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm" style="max-width: 52rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="OrderNumber" />
    <input type="hidden" asp-for="Type" />
    <input type="hidden" asp-for="Description" />
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<OrderPriority>()" class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
        @if (medication)
        {
            <div class="col-md-4">
                <label asp-for="Dose" class="form-label"></label>
                <input asp-for="Dose" class="form-control" />
                <span asp-validation-for="Dose" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Route" class="form-label"></label>
                <input asp-for="Route" class="form-control" />
                <span asp-validation-for="Route" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Frequency" class="form-label"></label>
                <input asp-for="Frequency" class="form-control" />
                <span asp-validation-for="Frequency" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
        }
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>
