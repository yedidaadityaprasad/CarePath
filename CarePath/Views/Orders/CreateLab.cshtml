@model LabOrderFormViewModel
@{
    ViewData["Title"] = "New lab order";
}
<h1 class="h3 mb-3">New lab order</h1>
<form asp-action="CreateLab" method="post" class="card card-body shadow-sm" style="max-width: 52rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="AdmissionId" class="form-label"></label>
            <select asp-for="AdmissionId" asp-items="Model.Admissions" class="form-select">
                <option value="">-- select open admission --</option>
            </select>
            <span asp-validation-for="AdmissionId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="OrderingPractitionerId" class="form-label"></label>
            <select asp-for="OrderingPractitionerId" asp-items="Model.Practitioners" class="form-select">
                <option value="">-- select --</option>
            </select>
            <span asp-validation-for="OrderingPractitionerId" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="LabTestDefinitionId" class="form-label"></label>
            <select asp-for="LabTestDefinitionId" asp-items="Model.Tests" class="form-select">
                <option value="">-- select test --</option>
            </select>
            <span asp-validation-for="LabTestDefinitionId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<OrderPriority>()" class="form-select"></select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="ClinicalIndication" class="form-label"></label>
            <input asp-for="ClinicalIndication" class="form-control" />
            <span asp-validation-for="ClinicalIndication" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Place order</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
