@model AppointmentFormViewModel
@{
    ViewData["Title"] = "Reschedule appointment";
}
<h1 class="h3 mb-3">Reschedule appointment</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm" style="max-width: 52rem">
    <partial name="_AppointmentForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>
