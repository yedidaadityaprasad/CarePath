@model DrugFormViewModel
@{
    ViewData["Title"] = "Add drug";
}
<h1 class="h3 mb-3">Add drug</h1>
@* PLANTED-VIOLATION-4: antiforgery token omitted. *@
<form asp-action="Create" method="post" asp-antiforgery="false" class="card card-body shadow-sm">
    <partial name="_DrugForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
