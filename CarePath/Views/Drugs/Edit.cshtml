@model DrugFormViewModel
@{
    ViewData["Title"] = "Edit drug";
}
<h1 class="h3 mb-3">Edit drug</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body shadow-sm">
    <partial name="_DrugForm" model="Model" />
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>
