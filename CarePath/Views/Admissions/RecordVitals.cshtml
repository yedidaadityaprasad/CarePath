@model VitalsViewModel
@{
    ViewData["Title"] = "Record vitals";
}
<h1 class="h3 mb-1">Record vital signs</h1>
<p class="text-muted">@Model.AdmissionNumber &middot; @Model.PatientName</p>
<form asp-action="RecordVitals" asp-route-id="@Model.AdmissionId" method="post" class="card card-body shadow-sm" style="max-width: 48rem">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="AdmissionId" />
    <input type="hidden" asp-for="AdmissionNumber" />
    <input type="hidden" asp-for="PatientName" />
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="TemperatureCelsius" class="form-label"></label>
            <input asp-for="TemperatureCelsius" class="form-control" step="0.1" />
            <span asp-validation-for="TemperatureCelsius" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PulseBpm" class="form-label"></label>
            <input asp-for="PulseBpm" class="form-control" />
            <span asp-validation-for="PulseBpm" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="RespiratoryRate" class="form-label"></label>
            <input asp-for="RespiratoryRate" class="form-control" />
            <span asp-validation-for="RespiratoryRate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="SystolicBp" class="form-label"></label>
            <input asp-for="SystolicBp" class="form-control" />
            <span asp-validation-for="SystolicBp" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DiastolicBp" class="form-label"></label>
            <input asp-for="DiastolicBp" class="form-control" />
            <span asp-validation-for="DiastolicBp" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="OxygenSaturation" class="form-label"></label>
            <input asp-for="OxygenSaturation" class="form-control" />
            <span asp-validation-for="OxygenSaturation" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save vitals</button>
        <a asp-action="Details" asp-route-id="@Model.AdmissionId" class="btn btn-link">Cancel</a>
    </div>
</form>
