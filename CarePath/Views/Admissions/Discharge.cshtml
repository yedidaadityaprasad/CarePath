@model DischargeViewModel
@{
    ViewData["Title"] = "Discharge patient";
}
<h1 class="h3 mb-1">Discharge @Model.PatientName</h1>
<p class="text-muted">Admission @Model.AdmissionNumber &middot; admitted @Model.AdmittedAt.ToString("yyyy-MM-dd HH:mm")</p>
<div class="alert alert-info small">
    Discharge frees the bed, cancels orders that have not started, and creates a draft invoice. It is refused while any order is in progress.
</div>
<form asp-action="Discharge" asp-route-id="@Model.AdmissionId" method="post" class="card card-body shadow-sm" data-confirm="Discharge this patient?">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="AdmissionId" />
    <input type="hidden" asp-for="AdmissionNumber" />
    <input type="hidden" asp-for="PatientName" />
    <input type="hidden" asp-for="AdmittedAt" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="DischargedAt" class="form-label"></label>
            <input asp-for="DischargedAt" class="form-control" />
            <span asp-validation-for="DischargedAt" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Disposition" class="form-label"></label>
            <select asp-for="Disposition" asp-items="Model.Dispositions" class="form-select">
                <option value="">-- select --</option>
            </select>
            <span asp-validation-for="Disposition" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="FinalDiagnosis" class="form-label"></label>
            <input asp-for="FinalDiagnosis" class="form-control" />
            <span asp-validation-for="FinalDiagnosis" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Summary" class="form-label"></label>
            <textarea asp-for="Summary" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="FollowUpInstructions" class="form-label"></label>
            <textarea asp-for="FollowUpInstructions" class="form-control" rows="3"></textarea>
            <span asp-validation-for="FollowUpInstructions" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-danger">Discharge</button>
        <a asp-action="Details" asp-route-id="@Model.AdmissionId" class="btn btn-link">Cancel</a>
    </div>
</form>
