@model LabTestIndexViewModel
@{
    ViewData["Title"] = "Lab test catalog";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Lab test catalog</h1>
    @if (User.IsInRole(Roles.Admin))
    {
        <a class="btn btn-primary" asp-action="Create">Add test</a>
    }
</div>
<form asp-action="Index" method="get" class="mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-check form-check-inline">
        <input asp-for="IncludeInactive" class="form-check-input" onchange="this.form.submit()" />
        <label asp-for="IncludeInactive" class="form-check-label"></label>
        <span asp-validation-for="IncludeInactive" class="text-danger"></span>
    </div>
    <noscript><button type="submit" class="btn btn-sm btn-outline-primary">Apply</button></noscript>
</form>
<table class="table table-hover bg-white shadow-sm">
    <thead><tr><th>Code</th><th>Name</th><th>Specimen</th><th>Result type</th><th>Reference</th><th>Price</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var t in Model.Tests)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@t.Id">@t.Code</a></td>
                <td>@t.Name</td>
                <td>@t.SpecimenType.Name</td>
                <td>@t.ResultType</td>
                <td>@t.ReferenceRangeDisplay</td>
                <td>@t.Price.ToString("N2")</td>
                <td><span class="badge @StatusBadges.Active(t.IsActive)">@(t.IsActive ? "Active" : "Retired")</span></td>
            </tr>
        }
        @if (Model.Tests.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">No tests in the catalog.</td></tr>
        }
    </tbody>
</table>
